        "def focal(logit, gt):\n",
        "    p = logit.sigmoid().clamp(1e-4, 1-1e-4)\n",
        "    pos = gt.eq(1).float()\n",
        "    pl = (torch.log(p) * (1-p)**2 * pos).sum()\n",
        "    nl = (torch.log(1-p) * p**2 * (1-gt)**4 * (1-pos)).sum()\n",
        "    return -(pl + nl) / pos.sum().clamp(min=1)\n",
        "\n",
        "def gather(feat, ind):                               # feat B,C,H,W ; ind B,K -> B,K,C\n",
        "    f = feat.flatten(2).permute(0, 2, 1)\n",
        "    return f.gather(1, ind.unsqueeze(-1).expand(-1, -1, f.shape[-1]))\n",
        "\n",
        "def box(cx, cy, w, h): return torch.stack([cx-w/2, cy-h/2, cx+w/2, cy+h/2], -1)\n",
        "\n",
        "def compute_loss(out, hm, ind, msk, wh, off):\n",
        "    hm_l, wh_l, off_l = [o.float() for o in out]\n",
        "    l_hm = focal(hm_l, hm)\n",
        "    pw, po = gather(wh_l, ind), gather(off_l, ind)           # log-size, offset\n",
        "    m, n, mk = msk.unsqueeze(-1), msk.sum().clamp(min=1), msk > 0\n",
        "    l_wh  = F.l1_loss(pw*m, torch.log(wh.clamp(min=1e-3))*m, reduction='sum') / n\n",
        "    l_off = F.l1_loss(po*m, off*m, reduction='sum') / n\n",
        "    l_giou = hm_l.sum() * 0\n",
        "    if mk.any():\n",
        "        ys, xs = (ind // W).float(), (ind % W).float()\n",
        "        s = pw.clamp(max=6).exp()\n",
        "        pb = box(xs + po[..., 0], ys + po[..., 1], s[..., 0], s[..., 1])\n",
        "        tb = box(xs + off[..., 0], ys + off[..., 1], wh[..., 0], wh[..., 1])\n",
        "        l_giou = generalized_box_iou_loss(pb[mk], tb[mk], reduction='sum') / n\n",
        "    return l_hm + l_wh + l_off + 2 * l_giou\n",
        "\n",
        "@torch.no_grad()\n",
        "def decode(hm, wh, off, topk=100, thr=0.05):\n",
        "    hm = hm.float().sigmoid()\n",
        "    hm = hm * (F.max_pool2d(hm, 3, 1, 1) == hm)              # keep only local peaks (replaces NMS)\n",
        "    B, _, Hh, Ww = hm.shape\n",
        "    sc, idx = hm.reshape(B, -1).topk(topk)\n",
        "    cls, pix = idx // (Hh*Ww), idx % (Hh*Ww)\n",
        "    ys, xs = (pix // Ww).float(), (pix % Ww).float()\n",
        "    g_wh = gather(wh.float(), pix).clamp(max=6).exp()\n",
        "    g_off = gather(off.float(), pix)\n",
        "    cx, cy = (xs + g_off[..., 0]) * R, (ys + g_off[..., 1]) * R\n",
        "    w, h = g_wh[..., 0] * R, g_wh[..., 1] * R\n",
        "    bx = box(cx, cy, w, h)\n",
        "    return [dict(boxes=bx[i][sc[i] > thr], scores=sc[i][sc[i] > thr], labels=cls[i][sc[i] > thr])\n",
        "            for i in range(B)]\n",
        "\n",
        "@torch.no_grad()\n",
        "def evaluate(m, loader):\n",
        "    m.eval(); metric = MeanAveragePrecision(iou_type='bbox')\n",
        "    for batch in loader:\n",
        "        x, gb, gl = batch[0].to(device).float()/255, batch[6], batch[7]\n",
        "        with torch.autocast('cuda'): out = m(x)\n",
        "        preds = [{k: v.cpu() for k, v in d.items()} for d in decode(*out)]\n",
        "        metric.update(preds, [dict(boxes=b, labels=l) for b, l in zip(gb, gl)])\n",
        "    return metric.compute()\n",
        "\n",
        "class EMA:\n",
        "    def __init__(s, model, decay=0.999):\n",
        "        s.m = copy.deepcopy(model).eval(); s.d, s.n = decay, 0\n",
        "        for p in s.m.parameters(): p.requires_grad_(False)\n",
        "    @torch.no_grad()\n",
        "    def update(s, model):\n",
        "        s.n += 1; d = min(s.d, (1 + s.n) / (10 + s.n))\n",
        "        for e, p in zip(s.m.state_dict().values(), model.state_dict().values()):\n",
        "            e.mul_(d).add_(p.detach(), alpha=1-d) if e.dtype.is_floating_point else e.copy_(p)"
