        "class Res(nn.Module):\n",
        "    def __init__(s, cin, cout, stride):\n",
        "        super().__init__()\n",
        "        s.c1 = nn.Conv2d(cin, cout, 3, stride, 1, bias=False); s.b1 = nn.BatchNorm2d(cout)\n",
        "        s.c2 = nn.Conv2d(cout, cout, 3, 1, 1, bias=False);     s.b2 = nn.BatchNorm2d(cout)\n",
        "        s.sc = None if (stride == 1 and cin == cout) else nn.Sequential(\n",
        "            nn.Conv2d(cin, cout, 1, stride, bias=False), nn.BatchNorm2d(cout))\n",
        "    def forward(s, x):\n",
        "        y = F.relu(s.b1(s.c1(x)), inplace=True)\n",
        "        y = s.b2(s.c2(y))\n",
        "        return F.relu(y + (x if s.sc is None else s.sc(x)), inplace=True)\n",
        "\n",
        "def cbr(cin, cout, k=3, s=1):\n",
        "    return nn.Sequential(nn.Conv2d(cin, cout, k, s, k//2, bias=False), nn.BatchNorm2d(cout), nn.ReLU(inplace=True))\n",
        "\n",
        "class Detector(nn.Module):\n",
        "    def __init__(self, C, ch=128):\n",
        "        super().__init__()\n",
        "        self.stem = cbr(3, 32, 3, 2)                                                    # /2\n",
        "        self.s1 = nn.Sequential(Res(32, 64, 2), Res(64, 64, 1))                         # /4\n",
        "        self.s2 = nn.Sequential(Res(64, 128, 2), Res(128, 128, 1))                      # /8\n",
        "        self.s3 = nn.Sequential(Res(128, 256, 2), Res(256, 256, 1), Res(256, 256, 1))   # /16\n",
        "        self.s4 = nn.Sequential(Res(256, 384, 2), Res(384, 384, 1))                     # /32\n",
        "        self.l1, self.l2, self.l3, self.l4 = [nn.Conv2d(c, ch, 1) for c in (64, 128, 256, 384)]\n",
        "        self.smooth = cbr(ch, ch)\n",
        "        def head(o, bias):\n",
        "            h = nn.Sequential(nn.Conv2d(ch, ch, 3, 1, 1), nn.ReLU(inplace=True), nn.Conv2d(ch, o, 1))\n",
        "            nn.init.constant_(h[-1].bias, bias); return h\n",
        "        self.hm, self.wh, self.off = head(C, -2.19), head(2, 1.0), head(2, 0.0)\n",
        "    def forward(self, x):\n",
        "        c1 = self.s1(self.stem(x)); c2 = self.s2(c1); c3 = self.s3(c2); c4 = self.s4(c3)\n",
        "        up = lambda t: F.interpolate(t, scale_factor=2, mode='nearest')\n",
        "        p = self.l3(c3) + up(self.l4(c4))\n",
        "        p = self.l2(c2) + up(p)\n",
        "        p = self.l1(c1) + up(p)                      # stride 4\n",
        "        p = self.smooth(p)\n",
        "        return self.hm(p), self.wh(p), self.off(p)\n",
        "\n",
        "model = Detector(C).to(device)\n",
        "print(sum(p.numel() for p in model.parameters())/1e6, 'M params (all random init)')"
