        "def load_split(split, limit=None):\n",
        "    paths = sorted(glob.glob(str(ROOT/split/'images'/'*')))\n",
        "    if limit: paths = random.Random(0).sample(paths, min(limit, len(paths)))\n",
        "    X = np.empty((len(paths), IMG, IMG, 3), np.uint8)\n",
        "    def work(i):\n",
        "        im = Image.open(paths[i]); im.draft('RGB', (IMG, IMG))\n",
        "        X[i] = np.asarray(im.convert('RGB').resize((IMG, IMG), Image.BILINEAR))\n",
        "    with ThreadPoolExecutor(8) as ex:\n",
        "        list(tqdm(ex.map(work, range(len(paths))), total=len(paths), desc=split))\n",
        "    L = []\n",
        "    for p in paths:\n",
        "        lp = ROOT/split/'labels'/(Path(p).stem + '.txt')\n",
        "        rows = [l.split()[:5] for l in open(lp) if len(l.split()) >= 5] if lp.exists() else []\n",
        "        L.append(np.array(rows, dtype=np.float32).reshape(-1, 5))\n",
        "    mx = max((l[:, 0].max() for l in L if len(l)), default=0)\n",
        "    print(split, X.shape, 'max class id:', int(mx))\n",
        "    assert mx < C, 'class id >= number of classes'\n",
        "    return X, L\n",
        "\n",
        "Xtr, Ltr = load_split('train', MAX_TRAIN)\n",
        "Xva, Lva = load_split('valid', 600)\n",
        "Xte, Lte = load_split('test')"
