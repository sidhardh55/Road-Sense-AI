        "val_dl  = DataLoader(DS(Xva, Lva, False), batch_size=32, num_workers=2, collate_fn=collate)\n",
        "test_dl = DataLoader(DS(Xte, Lte, False), batch_size=32, num_workers=2, collate_fn=collate)"
