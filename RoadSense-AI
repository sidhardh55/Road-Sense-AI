        "def draw_gaussian(hm, cx, cy, sx, sy):\n",
        "    rx, ry = max(int(3*sx), 1), max(int(3*sy), 1)\n",
        "    ys = np.arange(-ry, ry+1)[:, None]; xs = np.arange(-rx, rx+1)[None, :]\n",
        "    g = np.exp(-(xs**2/(2*sx*sx) + ys**2/(2*sy*sy)))\n",
        "    l, r = min(cx, rx), min(W-cx, rx+1)\n",
        "    t, b = min(cy, ry), min(H-cy, ry+1)\n",
        "    patch = hm[cy-t:cy+b, cx-l:cx+r]\n",
        "    np.maximum(patch, g[ry-t:ry+b, rx-l:rx+r], out=patch)\n",
        "    hm[cy, cx] = 1.0\n",
        "\n",
        "class DS(Dataset):\n",
        "    def __init__(self, X, L, train): self.X, self.L, self.train = X, L, train\n",
        "    def __len__(self): return len(self.X)\n",
        "    def __getitem__(self, i):\n",
        "        img, b = self.X[i], self.L[i].copy()                  # b: cls,cx,cy,w,h (0-1)\n",
        "        if self.train:\n",
        "            if random.random() < 0.5:                         # horizontal flip\n",
        "                img = img[:, ::-1]; b[:, 1] = 1 - b[:, 1]\n",
        "            if random.random() < 0.5 and len(b):              # random zoom-crop\n",
        "                f = random.uniform(0.6, 1.0)\n",
        "                x0, y0 = random.uniform(0, 1-f), random.uniform(0, 1-f)\n",
        "                x1, y1 = b[:,1]-b[:,3]/2, b[:,2]-b[:,4]/2\n",
        "                x2, y2 = b[:,1]+b[:,3]/2, b[:,2]+b[:,4]/2\n",
        "                a0 = (x2-x1)*(y2-y1)\n",
        "                nx1, ny1 = np.clip((x1-x0)/f, 0, 1), np.clip((y1-y0)/f, 0, 1)\n",
        "                nx2, ny2 = np.clip((x2-x0)/f, 0, 1), np.clip((y2-y0)/f, 0, 1)\n",
        "                keep = ((nx2-nx1)*(ny2-ny1) > 0.4*a0) & (nx2-nx1 > 0.004) & (ny2-ny1 > 0.004)\n",
        "                b = np.stack([b[:,0], (nx1+nx2)/2, (ny1+ny2)/2, nx2-nx1, ny2-ny1], 1)[keep]\n",
        "                p0, q0, s = int(x0*IMG), int(y0*IMG), int(f*IMG)\n",
        "                img = np.asarray(Image.fromarray(np.ascontiguousarray(img[q0:q0+s, p0:p0+s]))\n",
        "                                 .resize((IMG, IMG), Image.BILINEAR))\n",
        "        hm = np.zeros((C, H, W), np.float32)\n",
        "        ind = np.zeros(K, np.int64); msk = np.zeros(K, np.float32)\n",
        "        wh = np.ones((K, 2), np.float32); off = np.zeros((K, 2), np.float32)\n",
        "        for k, (c, cx, cy, w, h) in enumerate(b[:K]):\n",
        "            cx, cy, w, h = cx*W, cy*H, w*W, h*H               # output-grid units\n",
        "            ci, cj = min(int(cx), W-1), min(int(cy), H-1)\n",
        "            draw_gaussian(hm[int(c)], ci, cj, max(0.54*w/6, 0.5), max(0.54*h/6, 0.5))\n",
        "            ind[k], msk[k] = cj*W + ci, 1\n",
        "            wh[k], off[k] = (w, h), (cx-ci, cy-cj)\n",
        "        xyxy = np.stack([b[:,1]-b[:,3]/2, b[:,2]-b[:,4]/2, b[:,1]+b[:,3]/2, b[:,2]+b[:,4]/2], 1) * IMG\n",
        "        return (torch.from_numpy(np.array(img)).permute(2, 0, 1),\n",
        "                torch.from_numpy(hm), torch.from_numpy(ind), torch.from_numpy(msk),\n",
        "                torch.from_numpy(wh), torch.from_numpy(off),\n",
        "                torch.from_numpy(xyxy.astype(np.float32)), torch.from_numpy(b[:, 0].astype(np.int64)))\n",
        "\n",
        "def collate(batch):\n",
        "    cols = list(zip(*batch))\n",
        "    return [torch.stack(c) for c in cols[:6]] + [list(cols[6]), list(cols[7])]\n",
        "\n",
        "train_dl = DataLoader(DS(Xtr, Ltr, True), batch_size=16, shuffle=True, num_workers=4,\n",
